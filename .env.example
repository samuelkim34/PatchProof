# Copy this file to .env and replace the placeholders.
# Keep .env private: it is intentionally excluded from Git.
GEMINI_API_KEY=replace_with_your_gemini_api_key
DAYTONA_API_KEY=replace_with_your_daytona_api_key

# Optional: select another model available to your API key.
# PATCHPROOF_MODEL=gemini-3.6-flash

# Optional: required for scans hosted on Vercel; not a substitute for full authentication.
# PATCHPROOF_DEMO_CODE=replace_with_a_private_code
